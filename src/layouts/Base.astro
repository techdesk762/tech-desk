---
import '../styles/global.css';
import { site } from '../site.config.js';

const {
  title,
  description = site.description,
  image,
  type = 'website',
  jsonLd,
  pubDate,
  updated,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {site.adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <nav aria-label="Main">
          <a href="/">Latest</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>
    <main><div class="wrap"><slot /></div></main>
    <footer class="site">
      <div class="wrap">
        <p>
          <a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/rss.xml">RSS</a>
        </p>
        <p>&copy; {new Date().getFullYear()} {site.name}. Articles are drafted with AI assistance from linked primary sources and checked by an automated fact-review step.</p>
      </div>
    </footer>
  </body>
</html>
