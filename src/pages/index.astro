---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../site.config.js';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [lead, ...rest] = posts;
const more = rest.slice(0, 10);
---
<Base>
  <section class="intro">
    <h1>{site.name}</h1>
    <p class="lede">{site.description}</p>
  </section>
  {!lead && <p>No posts yet.</p>}
  {lead && <PostCard post={lead} hero />}
  <div class="grid">
    {more.map((p) => <PostCard post={p} />)}
  </div>
  {rest.length > 10 && (
    <p class="more"><a class="btn" href="/archive/">Browse all {posts.length} articles &rarr;</a></p>
  )}
</Base>
