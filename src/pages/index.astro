---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site.config.js';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [lead, ...rest] = posts;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<Base>
  <h1>{site.name}</h1>
  <p class="lede">{site.description}</p>

  {!lead && <p>No posts yet. Run <code>npm run pipeline</code> to publish the first ones.</p>}

  {lead && (
    <article class="lead">
      {lead.data.cover && <a href={`/blog/${lead.id}`}><img src={lead.data.cover} alt={lead.data.coverAlt} width="1200" height="630" /></a>}
      <h2><a href={`/blog/${lead.id}`}>{lead.data.title}</a></h2>
      <p class="meta"><time datetime={lead.data.pubDate.toISOString()}>{fmt(lead.data.pubDate)}</time></p>
      <p>{lead.data.description}</p>
    </article>
  )}

  <ul class="entries">
    {rest.map((p) => (
      <li class="entry">
        <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
        <div>
          <h2><a href={`/blog/${p.id}`}>{p.data.title}</a></h2>
          <p>{p.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
</Base>
