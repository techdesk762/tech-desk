---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.js';
---
<Base title="Terms of Use" description={`Terms of use for ${site.name}`}>
  <h1>Terms of Use</h1>
  <div class="prose">
    <p>By using {site.name} you agree to these terms.</p>
    <h2>Informational purposes only</h2>
    <p>Articles are AI-assisted and provided for general information. Verify important details against the linked primary sources before acting on them. We provide no warranty of accuracy, completeness or fitness for a particular purpose.</p>
    <h2>Content use</h2>
    <p>You may quote short excerpts with a link back to the article. Do not republish full articles without permission.</p>
    <h2>Third-party content</h2>
    <p>We link to third-party sites and are not responsible for their content.</p>
    <h2>Changes</h2>
    <p>We may update these terms at any time. Continued use means you accept the updated terms.</p>
    <p>Contact: <a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
</Base>
